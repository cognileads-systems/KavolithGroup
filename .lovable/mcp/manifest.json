{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://wfmnlfjwbdvsdjmhgnlz.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "cognileads-systems-mcp",
      "version": "0.1.0",
      "title": "VectraSyn"
    },
    "tools": [
      {
        "name": "submit_lead",
        "title": "Submit Lead",
        "description": "Capture a new inbound lead in the signed-in user's VectraSyn pipeline. Use for prospect names, emails, companies, and inbound messages.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "description": "Prospect name.",
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
              "description": "Prospect email address."
            },
            "company": {
              "description": "Prospect company / organization.",
              "type": "string"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "description": "Inbound message or context about the lead."
            }
          },
          "required": [
            "email",
            "message"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_my_leads",
        "title": "List My Leads",
        "description": "List the inbound leads captured by the signed-in user, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max number of leads to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
